    "get_digit_sum": {
        "prefix": "dsum",
        "body": [
            "int sum(int N){",
            "    int sum = 0;",
            "    while (N > 0){",
            "        sum += N % 10;",
            "        N = N / 10;",
            "    }",
            "    return sum;",
            "}"
        ],
        "description": "各桁の和"
    },
    "rotate90degree": {
        "prefix": "rot90",
        "body": [
            "vector<vector<char>> rotate90(const vector<vector<char>> &s)",
            "{",
            "    vector<vector<char>> res(s.size(), vector<char>(s.size()));",
            "    for (int i = 0; i < s.size(); i++)",
            "        for (int j = 0; j < s.size(); j++)",
            "            res[j][s.size() - i - 1] = s[i][j];",
            "    return res;",
            "}"
        ],
        "description": "二次元配列90°回転"
    },
    "素数判定": {
        "prefix": "is_prime",
        "body": [
            "bool is_prime(long long n) {",
            "    if (n <= 1) return false;",
            "    for (long long i = 2; i * i <= n; i++) {",
            "        if (n % i == 0) return false;",
            "    }",
            "    return true;",
            "}"
        ],
        "description": "素数判定 (O(√N))"
    },
    "素因数分解": {
        "prefix": "prime_factorize",
        "body": [
            "std::vector<long long> prime_factorize(long long n) {",
            "    std::vector<long long> res;",
            "    for (long long i = 2; i * i <= n; i++) {",
            "        while (n % i == 0) {",
            "            res.push_back(i);",
            "            n /= i;",
            "        }",
            "    }",
            "    if (n != 1) res.push_back(n);",
            "    return res;",
            "}"
        ],
        "description": "素因数分解 (O(√N))"
    },
    "約数全列挙": {
        "prefix": "get_divisors",
        "body": [
            "std::vector<long long> get_divisors(long long n) {",
            "    std::vector<long long> res;",
            "    for (long long i = 1; i * i <= n; i++) {",
            "        if (n % i == 0) {",
            "            res.push_back(i);",
            "            if (i * i != n) {",
            "                res.push_back(n / i);",
            "            }",
            "        }",
            "    }",
            "    std::sort(res.begin(), res.end());",
            "    return res;",
            "}"
        ],
        "description": "約数全列挙 (O(√N))"
    },
