    "Union-Find": {
        "prefix": "uf",
        "body": [
            "struct UnionFind {",
            "    vector<int> par;",
            "",
            "    UnionFind() { }",
            "    UnionFind(int n) : par(n, -1) { }",
            "    void init(int n) { par.assign(n, -1); }",
            "",
            "    int root(int x) {",
            "        if (par[x] < 0) return x;",
            "        else return par[x] = root(par[x]);",
            "    }",
            "",
            "    bool issame(int x, int y) {",
            "        return root(x) == root(y);",
            "    }",
            "",
            "    bool merge(int x, int y) {",
            "        x = root(x); y = root(y);",
            "        if (x == y) return false;",
            "        if (par[x] > par[y]) swap(x, y); // merge technique",
            "        par[x] += par[y];",
            "        par[y] = x;",
            "        return true;",
            "    }",
            "",
            "    int size(int x) {",
            "        return -par[root(x)];",
            "    }",
            "};"
        ],
        "description": "Union-Find tree"
    },
    "Dijkstra": {
        "prefix": "dij",
        "body": [
            "const ll inf = 1LL << 60;",
            "",
            "struct edge{",
            "    ll to;",
            "    ll leng;",
            "};",
            "",
            "vector<ll> Dij(const vector<vector<edge>>& G,ll first){",
            "    ll N=G.size();",
            "    vector<ll> dist(N,inf);",
            "    priority_queue<pl, vector<pl>, greater<pl>> pq;",
            "    vector<bool> ok(N,false);",
            "    dist[first]=0;",
            "    pq.push({dist[first],first});",
            "    while(!pq.empty()){",
            "        ll n,m;",
            "        tie(n,m)=pq.top();",
            "        pq.pop();",
            "        if(ok[m]==false){",
            "            ok[m]=true;",
            "            dist[m]=n;",
            "            for(auto x:G[m]){",
            "                if(ok[x.to]==false){",
            "                    pq.push({dist[m]+x.leng,x.to});",
            "                }",
            "            }",
            "        }",
            "    }",
            "    return dist;",
            "}"
        ],
        "description": "Dijkstra's algorithm for shortest path"
    },
    "Binary Search": {
        "prefix": "bs",
        "body": [
            "bool isOK(ll mid, vector<ll>& box) {",
            "    ll ans = 0;",
            "    for (int i = 0; i < box.size(); i++) {",
            "        ",
            "    }",
            "    if (mid <= ans) {",
            "        return false;",
            "    }",
            "    else {",
            "        return true;",
            "    }",
            "}",
            "",
            "void solve() {",
            "    ll left = 0;",
            "    ll right = 10000000000000000LL;",
            "    while (right - left > 1) {",
            "        ll mid = left + (right - left) / 2;",
            "        if (isOK(mid, box)) {",
            "            right = mid;",
            "        }",
            "        else {",
            "            left = mid;",
            "        }",
            "    }",
            "    cout << right << \"\\n\";",
            "}"
        ],
