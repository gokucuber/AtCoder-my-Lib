{
    "ahc_sa_template": {
        "prefix": "ahc",
        "body": [
            "#include <bits/stdc++.h>",
            "using namespace std;",
            "",
            "// ============================================================",
            "// AHC (AtCoder Heuristic Contest) 焼きなましテンプレート",
            "// 最大化問題を前提。最小化問題では delta の符号を反転させること。",
            "// ============================================================",
            "",
            "uint32_t xor_shift() {",
            "    static uint32_t y = 2463534242;",
            "    y ^= (y << 13); y ^= (y >> 17); return y ^= (y << 5);",
            "}",
            "",
            "inline double rand_double() {",
            "    return (double)xor_shift() / 0xFFFFFFFF;",
            "}",
            "",
            "struct Timer {",
            "    chrono::high_resolution_clock::time_point start_time;",
            "    Timer() : start_time(chrono::high_resolution_clock::now()) {}",
            "    inline double elapsed() const {",
            "        auto now = chrono::high_resolution_clock::now();",
            "        return chrono::duration<double>(now - start_time).count();",
            "    }",
            "};",
            "",
            "// delta = new_score - old_score (最大化前提)",
            "// 最小化問題なら delta = old_score - new_score として渡すこと",
            "inline bool should_accept(long long delta, double temp) {",
            "    if (delta >= 0) return true;",
            "    if (temp <= 1e-9) return false;",
            "    return rand_double() < exp((double)delta / temp);",
            "}",
            "",
            "// TODO: 問題に合わせて状態(解)を表す構造体を定義する",
            "struct State {",
            "    long long score = 0;",
            "    // TODO: 実際に持たせるデータ (vector<int> など) をここに追加",
            "",
            "    long long calc_score() const {",
            "        // TODO: スコア計算ロジック",
            "        return score;",
            "    }",
            "};",
            "",
            "int main() {",
            "    ios::sync_with_stdio(false);",
            "    cin.tie(nullptr);",
            "",
            "    Timer timer;",
            "    const double TIME_LIMIT = 1.85; // 出力コストを見込んで余裕を持たせる(問題の出力サイズに応じて調整)",
            "    const double START_TEMP = 100.0;",
            "    const double END_TEMP = 0.1;",
            "",
            "    // TODO: 入力受取",
            "",
            "    State current;",
            "    // TODO: 初期解構築",
            "    current.score = current.calc_score();",
            "",
            "    State best = current;",
            "    long long best_score = current.score;",
            "",
            "    long long iter = 0;",
            "    while (true) {",
            "        double time = timer.elapsed();",
            "        if (time >= TIME_LIMIT) break;",
            "        iter++;",
            "",
            "        // 指数関数的減衰(線形にしたい場合は下のコメント行に差し替え)",
            "        double temp = START_TEMP * pow(END_TEMP / START_TEMP, time / TIME_LIMIT);",
            "        // double temp = START_TEMP + (END_TEMP - START_TEMP) * (time / TIME_LIMIT);",
            "",
            "        // TODO: 近傍操作(状態を変化させる)",
            "        long long old_score = current.score;",
            "        // ... ここで current の状態を変更する ...",
            "        long long new_score = current.calc_score();",
            "        long long delta = new_score - old_score; // 最大化前提。最小化なら old_score - new_score",
            "",
            "        if (should_accept(delta, temp)) {",
            "            current.score = new_score;",
            "            if (current.score > best_score) {",
            "                best_score = current.score;",
            "                best = current; // ベスト更新",
            "            }",
            "        } else {",
            "            // TODO: 直前の近傍操作をロールバックして current を元に戻す",
            "        }",
            "    }",
            "",
            "    // TODO: best を使って解を出力する",
            "",
            "    cerr << \"Iter: \" << iter << \"\\n\";",
            "    cerr << \"Score: \" << best_score << \"\\n\";",
            "    return 0;",
            "}"
        ],
        "description": "AHC 焼きなまし法テンプレート(ベスト解保持・指数減衰付き)"
    },
