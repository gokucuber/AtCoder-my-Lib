    "2D Cumulative Sum / Imos": {
        "prefix": "imos2d",
        "body": [
            "void add(ll x, ll y, ll z, vector<vector<ll>>& data) {",
            "    ++x; ++y;",
            "    data[x][y] += z;",
            "}",
            "",
            "void add4(ll x1, ll y1, ll x2, ll y2, ll z, vector<vector<ll>>& data){",
            "    x1++; y1++; x2++; y2++;",
            "    data[x1][y1] += z;",
            "    data[x1][y2] -= z;",
            "    data[x2][y1] -= z;",
            "    data[x2][y2] += z;",
            "}",
            "",
            "void build(vector<vector<ll>>& data) {",
            "    reps(i, 1, data.size()){",
            "        reps(j, 1, data[i].size()){",
            "            data[i][j] += data[i][j - 1] + data[i - 1][j] - data[i - 1][j - 1];",
            "        }",
            "    }",
            "}",
            "",
            "ll query(ll sx, ll sy, ll gx, ll gy, vector<vector<ll>>& data) {",
            "    return (data[gx][gy] - data[sx][gy] - data[gx][sy] + data[sx][sy]);",
            "}"
        ],
        "description": "2D Cumulative Sum and Imos method"
    },
    "エラトステネスの篩": {
        "prefix": "sieve",
        "body": [
            "// n 以下の素数をすべて列挙する (O(N log log N))",
            "vl sieve(ll n) {",
            "    vector<bool> is_p(n + 1, true);",
            "    vl primes;",
            "    if (n >= 0) is_p[0] = false;",
            "    if (n >= 1) is_p[1] = false;",
            "    for (ll i = 2; i * i <= n; i++) {",
            "        if (is_p[i]) {",
            "            for (ll j = i * i; j <= n; j += i) {",
            "                is_p[j] = false;",
            "            }",
            "        }",
            "    }",
            "    reps(i, 2, n + 1) {",
            "        if (is_p[i]) primes.push_back(i);",
            "    }",
            "    return primes;",
            "}"
        ],
        "description": "エラトステネスの篩による素数列挙 (O(N log log N))"
    }
